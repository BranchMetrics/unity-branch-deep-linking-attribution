# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
*/[Ll]ibrary/
*/[Tt]emp/
*/[Oo]bj/
*/[Bb]uild/
*/[Bb]uilds/
*/[Ll]ogs/
*/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# ignore the asset store tools plugin
/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# macOS
*.DS_Store

# External Dependency Manager resolved Android files
BranchUnityTestBed/Assets/Plugins/Android/*

# Ignore Firebase Editor Resources
BranchUnityTestBed/Assets/Editor\ Default\ Resources/Firebase/
BranchUnityTestBed/Assets/Editor\ Default\ Resources/Firebase.meta
BranchUnityTestBed/Assets/Firebase/
BranchUnityTestBed/Assets/Firebase.meta

# Ignore External Dependency Manager (EDM4U)
BranchUnityTestBed/Assets/ExternalDependencyManager/
BranchUnityTestBed/Assets/ExternalDependencyManager.meta
BranchUnityTestBed/Assets/PlayServicesResolver/
BranchUnityTestBed/Assets/PlayServicesResolver.meta

BranchUnityTestBed/Assets/Firebase/Plugins/**/*.bundle
BranchUnityTestBed/Assets/Firebase/Plugins/**/*.so
*.csproj
*.sln


# Local IDE Settings
.vscode/
**/.vscode/

# User-specific Firebase/Google configurations
BranchUnityTestBed/Assets/StreamingAssets/google-services-desktop.json*
BranchUnityTestBed/Assets/GoogleService-Info.plist*

# Hidden Firebase Plugin libraries
BranchUnityTestBed/Assets/Plugins/iOS/Firebase/
BranchUnityTestBed/Assets/Plugins/iOS/Firebase.meta
BranchUnityTestBed/Assets/Plugins/tvOS/Firebase/
BranchUnityTestBed/Assets/Plugins/tvOS/Firebase.meta

# Auto-generated Unity settings
BranchUnityTestBed/ProjectSettings/MultiplayerManager.asset
BranchUnityTestBed/Assets/Settings/
BranchUnityTestBed/Assets/Settings.meta
